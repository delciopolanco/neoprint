#!/bin/bash
# Stop a running neoprint (and its LaunchAgent) before the payload is replaced.
# Never fail the install because of this.
console_user=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)
if [ -n "$console_user" ] && [ "$console_user" != "root" ]; then
  uid=$(/usr/bin/id -u "$console_user")
  /bin/launchctl bootout "gui/$uid/com.neogeniux.neoprint" >/dev/null 2>&1 || true
fi
/usr/bin/pkill -x neoprint >/dev/null 2>&1 || true
exit 0
